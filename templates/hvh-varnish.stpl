# Managed by varnish-for-hestia
# Additional Hestia TLS proxy template. The cache/origin upstream uses HTTP.
upstream hvh_https_%user%_%domain_idn% {
    server 127.0.0.1:6081;
    server %ip%:%web_port% backup;
}
server {
    listen %ip%:%proxy_ssl_port% ssl;
    server_name %domain_idn% %alias_idn%;
    error_log /var/log/%web_system%/domains/%domain%.error.log error;
    ssl_certificate %ssl_pem%;
    ssl_certificate_key %ssl_key%;
    if ($anti_replay = 307) { return 307 https://$host$request_uri; }
    if ($anti_replay = 425) { return 425; }
    include %home%/%user%/conf/web/%domain%/nginx.hsts.conf*;
    if ($request_method ~ ^(PURGE|BAN)$) { return 405; }
    location ~ /\.(?!well-known\/|file) { deny all; return 404; }
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Early-Data $rfc_early_data;
    proxy_set_header Connection "";
    proxy_next_upstream error timeout;
    location / {
        proxy_pass http://hvh_https_%user%_%domain_idn%;
        location ~* ^.+\.(%proxy_extensions%)$ {
            try_files $uri @fallback;
            root %sdocroot%;
            access_log /var/log/%web_system%/domains/%domain%.log combined;
            access_log /var/log/%web_system%/domains/%domain%.bytes bytes;
            expires max;
        }
    }
    location @fallback { proxy_pass http://hvh_https_%user%_%domain_idn%; }
    location /error/ { alias %home%/%user%/web/%domain%/document_errors/; }
    proxy_hide_header Upgrade;
    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
